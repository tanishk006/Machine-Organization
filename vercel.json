{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd auto-controlled-lights && npm run build",
  "installCommand": "cd auto-controlled-lights && npm install",
  "outputDirectory": "auto-controlled-lights/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
